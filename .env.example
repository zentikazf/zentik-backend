# ── APP ──────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_URL=https://your-api.railway.app
WEB_URL=https://your-app.vercel.app
API_PREFIX=/api/v1

# ── DATABASE ────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/zentik?schema=public

# ── REDIS ───────────────────────────────────────
REDIS_URL=redis://default:pass@host:6379

# ── AUTH ────────────────────────────────────────
BETTER_AUTH_SECRET=generate-a-32-char-secret-here!!
BETTER_AUTH_URL=https://your-api.railway.app
# Cutover a cookie same-site (migración front/back a subdominios del mismo dominio).
# false (default) = cookie plana + SameSite=none (cross-site Vercel/Railway actual).
# true (post-migración same-site) = prefijo __Host- + SameSite=Lax. Flip sin deploy.
COOKIE_SAMESITE_LAX=false

# ── STORAGE (S3/R2/MinIO) ──────────────────────
STORAGE_ENDPOINT=https://your-s3-endpoint.com
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=zentik-files
STORAGE_REGION=us-east-1

# ── EMAIL (optional) ───────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@zentik.app
SENDGRID_FROM_NAME=Zentik

# ── OAUTH (optional) ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── MONITORING (optional) ──────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── ADMIN MCP CHAT (feature #8) ────────────────
# URL completa del MCP HTTP (required, incluye /mcp suffix).
MCP_BASE_URL=https://zentikazf-mcp-production.up.railway.app/mcp
# Timeout por call HTTP al MCP (ms). Default 15000.
MCP_HTTP_TIMEOUT_MS=15000
# TTL del cache de tools/list (segundos). Default 300 (5 min).
MCP_TOOLS_CACHE_TTL_SEC=300

# ==============================================================================
# ADMIN MCP CHAT - LLM CONFIG
# ==============================================================================
# Provider del LLM. Opciones: openrouter | deepseek | openai | qwen.
# Todos usan el mismo SDK (`openai`) — solo cambia LLM_BASE_URL + LLM_MODEL.
LLM_PROVIDER=openrouter

# Modelo LLM a usar (identifier del provider). Ejemplos:
#   - openai/gpt-4o-mini       (recomendado default: $0.15 in / $0.60 out por MTok, obediente + tool calling nativo)
#   - anthropic/claude-haiku-4.5   (fallback: $1 in / $5 out, muy obediente en multi-turn tool use)
#   - anthropic/claude-sonnet-4-5  (premium: $3 in / $15 out, top-tier pero caro)
#   - deepseek/deepseek-chat       (cheap: <$0.30 in / <$0.90 out, puede degradar sin capa 2)
LLM_MODEL=openai/gpt-4o-mini

# API key del provider (secret - NUNCA commitear la real).
LLM_API_KEY=sk-or-v1-...

# Opcional: base URL override (para providers self-hosted).
# Defaults conocidos por el factory si no se setea:
#   openrouter -> https://openrouter.ai/api/v1
#   deepseek   -> https://api.deepseek.com
#   openai     -> https://api.openai.com/v1
#   qwen       -> https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BASE_URL=https://api.openrouter.ai/v1

# Max output tokens por turno del LLM. Default 4096.
LLM_MAX_TOKENS=4096

# Max iteraciones del loop tool_use -> tool_result -> ... por turno. Default 6.
LLM_MAX_ITERATIONS=6

# Timeout total por call al LLM (ms). Default 30000.
LLM_TIMEOUT_MS=30000

# Rate limits del endpoint /admin/mcp/chat por usuario.
ADMIN_MCP_RATE_LIMIT_PER_MINUTE=30
ADMIN_MCP_RATE_LIMIT_PER_DAY=200

# ── BOTMAKER BILLING (feature #23 — Variables de facturación) ──
# Feature flag maestro. Con `false` (default) el boot NO requiere secretos Botmaker y el
# select de cuentas / import hacen early-return. Ponerlo en `true` habilita el camino admin.
BOTMAKER_BILLING_ENABLED=false
# Base URL del API de Botmaker (el service arma {BASE}/v2.0/billing/consumptions).
BOTMAKER_BASE_URL=https://api.botmaker.com
# Access-token de Botmaker (secret - NUNCA commitear ni loggear). Va en el header `access-token`.
BOTMAKER_ACCESS_TOKEN=
# Timeout por call HTTP a Botmaker (ms). Default 15000.
BOTMAKER_HTTP_TIMEOUT_MS=15000
# TTL del cache de consumo por período (segundos). Default 1800 (30 min).
BOTMAKER_CACHE_TTL_SEC=1800
# Tasa USD→PYG simulada (v1, fallback manual mientras no haya DNIT). El preview la muestra editable.
EXCHANGE_RATE_SIMULATED=
